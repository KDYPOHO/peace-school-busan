rules_version = '2';
// 부산 청년 평화학교 앱 보안 규칙
// - 참가자: 본인 신청서·출결·심화 지원서만 읽고 쓸 수 있음
// - 운영진(staff 컬렉션에 등록된 계정)은 역할(role)로 나눔
//   admin(관리자): 운영진 지정·해제 + 운영진 업무 전부 (role이 없는 기존 문서는 관리자로 봄)
//   staff(운영진): 전체 조회, 출석 처리, 공지, 문의, 선발, 심사
//   judge(심사위원): 해커톤 심사 점수만 (참가자 개인정보 열람 불가)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function staffRole() {
      let staffDoc = /databases/$(database)/documents/staff/$(me());
      return exists(staffDoc) ? get(staffDoc).data.get('role', 'admin') : '';
    }
    // 운영 업무(개인정보 열람 포함)는 관리자·운영진만. 심사위원은 제외
    function isStaff() {
      return signedIn() && staffRole() in ['admin', 'staff'];
    }
    function isAdmin() {
      return signedIn() && staffRole() == 'admin';
    }
    function canJudge() {
      return signedIn() && staffRole() in ['admin', 'staff', 'judge'];
    }
    function approvedParticipant(uid) {
      let profile = /databases/$(database)/documents/users/$(uid);
      // Profiles created before approval was introduced remain valid.
      return exists(profile) && get(profile).data.get('approvalStatus', 'approved') == 'approved';
    }
    function canUseCourse() {
      return signedIn() && (isStaff() || approvedParticipant(me()));
    }
    function enrollNo() { return 'BS27-' + me()[0:6].upper(); }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // 운영진 명단 (문서 ID = 운영진 uid)
    match /staff/{uid} {
      allow read: if signedIn() && (uid == me() || isStaff());
      allow create, update: if isAdmin()
        && request.resource.data.get('role', 'staff') in ['admin', 'staff', 'judge']
        && (!exists(/databases/$(database)/documents/users/$(uid)) || approvedParticipant(uid));
      allow delete: if isAdmin() && uid != me();
    }

    // 현장 정원 현황 (운영진 앱이 승인 현황에서 계산해 씀, 가입 화면 안내용)
    function onsiteFull() {
      let stat = /databases/$(database)/documents/stats/onsite;
      return exists(stat) && get(stat).data.get('full', false) == true;
    }
    match /stats/onsite {
      allow read: if signedIn();
      allow write: if isStaff()
        && request.resource.data.keys().hasOnly(['count', 'cap', 'full', 'at'])
        && request.resource.data.count is int && request.resource.data.cap is int
        && request.resource.data.full is bool;
    }

    // 참가자 신청서 / 프로필 (문서 ID = 본인 uid)
    match /users/{uid} {
      allow read: if signedIn() && (uid == me() || isStaff());
      allow create: if signedIn() && uid == me()
        && request.resource.data.consent == true
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        // 자문위원 인증은 운영진만: 본인은 '인증 대기'까지만 쓸 수 있음
        && request.resource.data.get('memberVerified', '') in ['', 'pending']
        && request.resource.data.get('approvalStatus', '') == 'pending'
        && !request.resource.data.keys().hasAny(['approvedAt', 'approvedBy'])
        // 신청서에 들어갈 수 있는 항목만 허용
        && request.resource.data.keys().hasOnly(['name', 'birthYear', 'phone', 'region', 'orgRegion', 'orgCouncil', 'memberType', 'memberVerified', 'memberTerm', 'memberNo', 'org', 'mode', 'optionalConsent', 'photoConsent', 'termsAgreed', 'privacyVersion', 'termsVersion', 'no', 'email', 'consent', 'consentAt', 'createdAt', 'approvalStatus'])
        // 수강번호는 계정 ID에서 정해지는 값만: 남의 번호를 흉내 낼 수 없게
        && request.resource.data.get('no', enrollNo()) == enrollNo()
        // 선택 동의가 없으면 휴대폰 번호·소속은 비워 둔다
        && (request.resource.data.get('optionalConsent', false) == true || (request.resource.data.get('phone', '') == '' && request.resource.data.get('org', '') == ''))
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.get('email', ''));
      allow update: if (isStaff() &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['approvalStatus', 'approvedAt', 'approvedBy', 'approvalNote'])
           || (resource.data.get('approvalStatus', '') in ['pending', 'hold']
               && onlyChanges(['approvalStatus', 'approvedAt', 'approvedBy', 'approvalNote', 'onsiteWaitlist'])
               && request.resource.data.get('approvalStatus', '') in ['approved', 'rejected', 'hold']
               && request.resource.data.get('approvalNote', '') is string
               && request.resource.data.get('approvalNote', '').size() <= 100
               && request.resource.data.get('approvedAt', null) == request.time
               && request.resource.data.get('approvedBy', '') == me())))
        || (signedIn() && uid == me()
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 40
            && (request.resource.data.get('optionalConsent', false) == true || (request.resource.data.get('phone', '') == '' && request.resource.data.get('org', '') == ''))
            && onlyChanges(['name', 'org', 'region', 'phone', 'mode', 'birthYear', 'updatedAt', 'largeText', 'optionalConsent', 'photoConsent', 'privacyVersion', 'termsVersion', 'orgRegion', 'orgCouncil', 'memberType', 'memberTerm', 'memberNo', 'memberVerified', 'onsiteWaitlist'])
            // 현장 대기 표시는 본인이 지울 수 없음. 정원이 찬 뒤 온라인→현장으로 바꾸면 대기로만
            && (request.resource.data.get('onsiteWaitlist', false) == resource.data.get('onsiteWaitlist', false)
                || request.resource.data.get('onsiteWaitlist', false) == true)
            && (request.resource.data.get('mode', '') != 'onsite' || resource.data.get('mode', '') == 'onsite'
                || !onsiteFull() || request.resource.data.get('onsiteWaitlist', false) == true)
            && (request.resource.data.get('memberVerified', '') == resource.data.get('memberVerified', '')
                || request.resource.data.get('memberVerified', '') in ['', 'pending']));
      allow delete: if isStaff() || (signedIn() && uid == me());
    }

    function onlineWindow(n) {
      let schedule = get(/databases/$(database)/documents/courseSchedule/$(string(n))).data;
      return schedule.opensAt <= request.time && request.time <= schedule.closesAt;
    }
    function validAttendance(id, d) {
      return d.lecture is int && d.lecture >= 1 && d.lecture <= 5
        && d.uid is string && id == string(d.lecture) + '_' + d.uid
        && d.at == request.time
        && approvedParticipant(d.uid);
    }
    match /attendance/{id} {
      allow get: if isStaff() || (canUseCourse() && (
        resource != null && resource.data.uid == me()
        || resource == null && id in ['1_' + me(), '2_' + me(), '3_' + me(), '4_' + me(), '5_' + me()]
      ));
      allow list: if isStaff() || (canUseCourse() && resource.data.uid == me());
      allow create: if canUseCourse() && validAttendance(id, request.resource.data) && (
        isStaff() && request.resource.data.keys().hasOnly(['uid', 'lecture', 'method', 'at', 'by'])
          && request.resource.data.method in ['qr', 'manual'] && request.resource.data.by == me()
        || request.resource.data.keys().hasOnly(['uid', 'lecture', 'method', 'at'])
          && request.resource.data.uid == me() && request.resource.data.method == 'online'
          && onlineWindow(request.resource.data.lecture)
      );
      allow delete: if isStaff() || (signedIn() && resource.data.uid == me());
    }

    match /courseSchedule/{id} {
      allow read: if canUseCourse();
    }

    function seatPath(n) {
      return /databases/$(database)/documents/deepSeats/$(string(n));
    }
    function deepPath(uid) {
      return /databases/$(database)/documents/deepApps/$(uid);
    }
    function seatOwnerAfter(n, uid) {
      return n is int && n >= 1 && n <= 40
        && existsAfter(seatPath(n)) && getAfter(seatPath(n)).data.uid == uid;
    }
    function freedSeat(n) {
      return n is int && !existsAfter(seatPath(n));
    }
    function validSelection(uid) {
      let old = resource.data;
      let next = request.resource.data;
      return onlyChanges(['status', 'decidedAt', 'seat'])
        && next.uid == uid && next.decidedAt == request.time
        && (next.status == 'selected'
              && seatOwnerAfter(next.seat, uid)
              && (old.status != 'selected' || old.get('seat', 0) == next.seat)
            || next.status in ['submitted', 'waitlist', 'rejected']
              && !next.keys().hasAny(['seat'])
              && (old.status != 'selected' || freedSeat(old.get('seat', 0))));
    }
    function beforeDeepDeadline() {
      return request.time < get(/databases/$(database)/documents/courseSchedule/deep).data.closesAt;
    }
    // 심화 지원 자격: 기본과정 4강 이상 출석 (config.js PASS_COUNT)
    function attended(n) {
      return exists(/databases/$(database)/documents/attendance/$(string(n) + '_' + me()));
    }
    function deepEligible() {
      return [attended(1), attended(2), attended(3), attended(4), attended(5)].removeAll([false]).size() >= 4;
    }
    match /deepApps/{uid} {
      allow read: if isStaff() || (canUseCourse() && uid == me());
      allow create: if canUseCourse() && uid == me() && beforeDeepDeadline() && deepEligible()
        && request.resource.data.uid == uid && request.resource.data.status == 'submitted'
        && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['uid', 'status', 'essay', 'arrival', 'theme', 'at']);
      allow update: if isStaff() && validSelection(uid)
        || (canUseCourse() && uid == me() && beforeDeepDeadline()
          && onlyChanges(['essay', 'arrival', 'updatedAt']));
      allow delete: if signedIn() && (uid == me() || isStaff())
        && (resource.data.status != 'selected' || freedSeat(resource.data.get('seat', 0)));
    }

    match /deepSeats/{slot} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['uid', 'seat'])
        && request.resource.data.uid is string
        && request.resource.data.seat is int && request.resource.data.seat >= 1 && request.resource.data.seat <= 40
        && slot == string(request.resource.data.seat)
        && existsAfter(deepPath(request.resource.data.uid))
        && getAfter(deepPath(request.resource.data.uid)).data.status == 'selected'
        && getAfter(deepPath(request.resource.data.uid)).data.seat == request.resource.data.seat;
      allow delete: if signedIn() && (isStaff() || resource.data.uid == me())
        && (!existsAfter(deepPath(resource.data.uid))
          || getAfter(deepPath(resource.data.uid)).data.status != 'selected');
    }

    function selected() {
      return exists(deepPath(me())) && get(deepPath(me())).data.status == 'selected';
    }
    // Older apps list the whole public collection. Private notices use their own access rule.
    match /notices/{id} {
      allow read: if canUseCourse();
      allow create, update: if isStaff() && request.resource.data.audience == 'all';
      allow delete: if isStaff();
    }

    match /deepNotices/{id} {
      allow read: if isStaff() || canUseCourse() && selected();
      allow create, update: if isStaff() && request.resource.data.audience == 'deep';
      allow delete: if isStaff();
    }

    match /users/{uid}/inboxReads/{key} {
      allow read: if canUseCourse() && uid == me();
      allow delete: if signedIn() && uid == me();
      allow create: if canUseCourse() && uid == me()
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
    }

    // 참가자 문의·운영진 답변
    function ownsQuestionId(id) {
      return me().matches('^[A-Za-z0-9_-]+$') && id.matches('^' + me() + '_[a-f0-9]{32}$');
    }
    match /questions/{id} {
      allow create: if canUseCourse()
        && request.resource.data.keys().hasOnly(['uid', 'text', 'at', 'status'])
        && request.resource.data.uid == me()
        && request.resource.data.status == 'open'
        && request.resource.data.at == request.time
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow list: if isStaff() || (canUseCourse() && resource.data.uid == me());
      allow get: if isStaff() || (canUseCourse() && (
        resource != null && resource.data.uid == me()
        || resource == null && ownsQuestionId(id)
      ));
      allow update: if isStaff()
        && onlyChanges(['answer', 'status', 'answeredAt', 'answeredBy'])
        && resource.data.get('answer', '') == ''
        && request.resource.data.answer is string
        && request.resource.data.answer.size() > 0
        && request.resource.data.answer.size() <= 500
        && request.resource.data.status == 'answered'
        && request.resource.data.answeredAt == request.time
        && request.resource.data.get('answeredBy', me()) == me();
      allow delete: if isStaff() || (signedIn() && resource.data.uid == me());
    }

    // 해커톤 심사 점수: 관리자·운영진·심사위원. 점수는 본인 이름으로만 쓰고 고침
    match /scores/{id} {
      allow read: if canJudge();
      allow create, update: if canJudge()
        && request.resource.data.keys().hasOnly(['round', 'team', 'crit', 'judge', 'at'])
        && request.resource.data.judge == me()
        && request.resource.data.round in ['예선', '본선']
        && id == request.resource.data.round + '_' + request.resource.data.team + '_' + me();
      allow delete: if isStaff() || (canJudge() && resource.data.judge == me());
    }

    // 그 밖의 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
