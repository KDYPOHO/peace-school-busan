{
  "name": "peace-school-busan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "부산 청년 평화학교 앱 (웹 + Android + iOS)",
  "scripts": {
    "serve": "npx http-server www -p 8080 -c-1",
    "sync": "npx cap sync",
    "android": "npx cap open android",
    "ios": "npx cap open ios",
    "build:web": "node scripts/bundle-web.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:firebase": "npx --yes firebase-tools@14.27.0 emulators:exec --only firestore,auth --project demo-hanbando-school \"node --test --test-concurrency=1 tests/*.firebase.mjs\""
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/ios": "^7.4.0",
    "firebase": "11.10.0",
    "html5-qrcode": "2.3.8",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@firebase/rules-unit-testing": "4.0.1",
    "esbuild": "0.25.12"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
